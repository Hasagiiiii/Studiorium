{
  "name": "studiorium-online",
  "version": "3.4.1",
  "private": true,
  "description": "Studiorium — plataforma acadêmica dark academia com redação certificada, templates livres, biblioteca e comunidades na Vercel + Supabase.",
  "type": "commonjs",
  "scripts": {
    "check": "node scripts/check-project.js && prettier --check .",
    "security:secrets": "node scripts/check-secrets.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.js",
    "hash-password": "node scripts/hash-password.js",
    "provision-admin": "node scripts/provision-admin.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
