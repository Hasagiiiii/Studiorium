SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_COLE_SUA_CHAVE_SECRETA_AQUI
# Compatibilidade opcional com projetos antigos:
# SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-legada-aqui
STUDIORIUM_ADMIN_EMAIL=seu-email@exemplo.com
STUDIORIUM_SITE_URL=https://studiorium.vercel.app

# Armarium Librorum: opcional. Quando definido, entra nos links de busca da Amazon Brasil.
# Consulte e cumpra os termos do programa de afiliados antes de ativar.
# STUDIORIUM_AMAZON_AFFILIATE_TAG=seu-tag-20

# Redefinição de senha por e-mail com Resend e remetente de domínio verificado.
# RESEND_API_KEY=re_...
# STUDIORIUM_EMAIL_FROM=Studiorium <seguranca@seu-dominio.com>
# Uso local e temporário apenas durante `npm run provision-admin`.
# Não configure esta variável na Vercel e não salve uma senha real neste arquivo.
# STUDIORIUM_ADMIN_PASSWORD=uma-senha-forte-com-12-ou-mais-caracteres
